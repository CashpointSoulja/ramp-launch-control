{
  "name": "ramp-launch-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Product operations command centre: customer voice triage, launch readiness gates and an incident board. Independent concept by Ayo Ahmed; not affiliated with Ramp.",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "evals": "node --experimental-strip-types eval/run.ts",
    "test:api": "node scripts/api-check.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "check": "npm run typecheck && npm test && npm run evals && npm run build && wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/workers-types": "4.20251014.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.4",
    "wrangler": "4.43.0"
  }
}
